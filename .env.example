# Copy to .env (git-ignored) and fill in your Personal Access Tokens.
# Jira and Confluence Data Center issue separate PATs:
#   Jira:       Profile > Personal Access Tokens
#   Confluence: Profile > Settings > Personal Access Tokens
JIRA_URL=https://jira.bri.co.id
JIRA_PAT=

CONFLUENCE_URL=https://confluence.bri.co.id
CONFLUENCE_PAT=

# Optional: path to the corporate root CA bundle (.pem) if you get SSL errors.
ATLASSIAN_CA_BUNDLE=
